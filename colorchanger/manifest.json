{
    "manifest_version": 3,
    "name": "Color Changer",
    "version": "1.0",
    "description": "Change background color of any website",
    "permissions": ["activeTab", "scripting"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    },
    "background": {
      "service_worker": "background.js"
    }
  }